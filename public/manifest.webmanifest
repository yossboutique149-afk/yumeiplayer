{
  "name": "YUMEIKA — The Music Universe",
  "short_name": "YUMEIKA",
  "description": "Offline-first fan app for the virtual artist Yumei (ka)Waii: albums, lyrics, translations, pronunciation, song decode and sing-along — installed on your phone, usable without internet.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0b0713",
  "theme_color": "#0b0713",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Music", "short_name": "Music", "url": "/music" },
    { "name": "Lyrics", "short_name": "Lyrics", "url": "/lyrics" },
    { "name": "Favorites", "short_name": "Saved", "url": "/favorites" },
    { "name": "Offline mode", "short_name": "Offline", "url": "/offline" }
  ]
}
